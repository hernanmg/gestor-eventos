generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Rol {
  ADMIN
  OPERADOR
  VIEWER
  JORNALERO
  // Identificador ASCII por restricción de Prisma (los enum values no aceptan
  // "Ñ") — el valor real en DB y en el runtime de Prisma Client es "PAÑOLERO"
  // (ver @map), que es lo que se usa en el resto del código (TS, JSON, zod).
  PANOLERO  @map("PAÑOLERO")
}

enum Tipo {
  EGRESO
  INGRESO
}

enum EstadoEvento {
  ACTIVO
  CERRADO
  IMPORTADO
}

enum TipoCuenta {
  EFECTIVO
  BANCO
}

enum EstadoCuenta {
  ABIERTA // operativa, recibiendo movimientos
  PENDIENTE_RENDICION // el responsable volvió, falta rendir
  CERRADA // rendición confirmada por admin
}

enum EstadoEcheq {
  PENDIENTE
  COBRADO
  RECHAZADO
}

enum Moneda {
  ARS
  USD
  EUR
}

enum UbicacionStock {
  DEPOSITO
  EN_TRANSITO // en camión, entre depósito y evento o entre eventos
  EN_EVENTO // armado en el lugar
  EXCEDENTE // enviado de más, en campo pero no usado
  ALQUILADO // material de terceros sumado temporalmente
  BAJA // dado de baja
}

enum EstadoAsignacion {
  ACTIVA
  TRANSFERIDA
  DEVUELTA
  CANCELADA
}

enum OrigenTransfer {
  DEPOSITO
  EVENTO
}

enum EstadoFactura {
  RECIBIDA
  APROBADA
  PAGADA
  ANULADA
}

enum MedioPago {
  TRANSFERENCIA
  ECHEQ
  EFECTIVO
  CHEQUE
}

enum CondicionPago {
  CONTADO
  DIAS_30
  DIAS_60
  DIAS_90
  ECHEQ
  OTRO
}

enum CategoriaEmpleado {
  CAPITAN
  ARMADOR
  CHOFER
  ADMINISTRATIVO
  TECNICO
  JORNALERO
  FOFI
  NESTORAS
  EXTRANJERO
  SERENO
  OTRO
}

enum EstadoEmpleado {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

enum EstadoJornada {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum EstadoLiquidacion {
  BORRADOR
  APROBADA
  PAGADA
  CANCELADA
}

enum TipoLiquidacion {
  LINEAL // horas_normales × valor_hora — modelo actual (Enjoy)
  JORNADA // por umbral de horas, con jornada completa/media — DOS57
}

enum TipoAnticipo {
  ADELANTO
  VALE
  DESCUENTO
}

enum TipoPanolItem {
  HERRAMIENTA
  CONSUMIBLE
}

enum EstadoPanolItem {
  DISPONIBLE
  FUERA_DE_SERVICIO
  BAJA
}

enum TipoMovPanol {
  SALIDA
  DEVOLUCION
  USO_INTERNO
  BAJA
}

enum EstadoActivo {
  BUENO
  REGULAR
  DETERIORADO
  BAJA
}

enum TipoRubro {
  EGRESO
  INGRESO
}

enum EstadoMovimiento {
  PENDIENTE
  COTIZANDO
  CONFIRMADO
  PAGADO
  CANCELADO
}

// ─── EMPRESAS (multitenancy — row-level tenancy) ─────────────────────────────

model Empresa {
  id             Int      @id @default(autoincrement())
  nombre         String
  nombre_corto   String?
  cuit           String?  @unique
  domicilio      String?
  logo_url       String?
  color_primario String?
  activo         Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // ── Identidad visual (Módulo A — Configuración de empresa) ──────────────────
  logo_data        Bytes? // logo guardado en DB (mismo patrón que PDF en facturas)
  logo_nombre      String?
  logo_mime        String?
  color_secundario String?

  // ── Datos fiscales y contacto ────────────────────────────────────────────────
  razon_social String?
  telefono     String?
  email        String?
  web          String?

  // ── Configuración operativa ──────────────────────────────────────────────────
  moneda_default Moneda @default(ARS)
  timezone       String @default("America/Argentina/Buenos_Aires")
  updated_by     Int?

  usuarios              Usuario[]
  usuarioEmpresaAccesos UsuarioEmpresaAcceso[]
  eventos               Evento[]
  proveedores           Proveedor[]
  tabConfigs            TabConfig[]
  categoriasStock       CategoriaStock[]
  cuentasBancarias      CuentaBancaria[]
  productos             Producto[]
  facturas              Factura[]
  auditoriaLogs         AuditoriaLog[]
  empleados             Empleado[]
  jornadas              Jornada[]
  anticipos             Anticipo[]
  liquidaciones         Liquidacion[]
  camiones              Camion[]
  cunas                 Cuna[]
  panolItems            PanolItem[]
  movimientosPanol      MovimientoPanol[]
  activos               Activo[]
  rubros                Rubro[]
  rubrosEvento          RubroEvento[]
  partesDiario          ParteDiario[]
  asignacionesDiarias   AsignacionDiaria[]
  pedidosComida         PedidoComida[]
  preMacros             PreMacro[]
  cuentasCorrientes     CuentaCorriente[]
  movimientosCCC        MovimientoCCC[]
  acuerdosSueldo        AcuerdoSueldo[]
  splitsEmpleados       EmpleadoEmpresaSplit[]
  liquidacionesAdmin    LiquidacionAdmin[]
}

// ─── USUARIOS ─────────────────────────────────────────────────────────────────

model Usuario {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  nombre        String
  apodo         String?
  telefono      String?
  password_hash String
  rol           Rol       @default(OPERADOR)
  activo        Boolean   @default(true)
  // Empresa activa de la sesión — null solo para el admin global (rol=ADMIN
  // sin fila en UsuarioEmpresaAcceso), que puede cambiar de empresa libremente.
  empresa_id    Int?
  empresa       Empresa?  @relation(fields: [empresa_id], references: [id])
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  // Vista Macro restringida por área — para usuarios ADMIN multi-empresa que
  // no son el admin global (ej. Mayra, Gerente Administrativa) pero necesitan
  // visibilidad cross-empresa acotada a ciertas áreas. Solo el admin global
  // puede tocar estos dos campos (ver usuarios.controller.ts#update).
  puede_ver_macro Boolean  @default(false)
  areas_macro     String[] // subconjunto de ["FINANZAS","ADMIN","RRHH","STOCK"]

  eventoAccesos          EventoAcceso[]
  auditoriaLogs          AuditoriaLog[]
  empresaAccesos         UsuarioEmpresaAcceso[]
  // Empleado vinculado — permite que el usuario cargue sus propias jornadas
  // (rol VIEWER + empleado no-null ⇒ vista de autoservicio RRHH).
  empleado               Empleado?
  movimientosResponsable Movimiento[]
  cuentasResponsable     CuentaBancaria[]
}

// Empresas a las que un usuario no-admin tiene acceso. Mismo patrón que
// EventoAcceso. Si un usuario tiene 1 sola fila, entra directo a esa empresa
// sin selector. Si tiene 2+, elige al login y queda fijo esa sesión.
model UsuarioEmpresaAcceso {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  usuario    Usuario  @relation(fields: [usuario_id], references: [id])
  empresa_id Int
  empresa    Empresa  @relation(fields: [empresa_id], references: [id])
  created_at DateTime @default(now())
  created_by Int?

  @@unique([usuario_id, empresa_id])
}

// ─── CONFIGURACIÓN DE PESTAÑAS (por empresa) ─────────────────────────────────
// 5 egresos + 5 ingresos por empresa. `nombre` es editable por el admin desde
// la UI. `codigo` es inmutable dentro de cada empresa y lo usa el importer
// Excel para mapear hojas.

model TabConfig {
  id         Int     @id @default(autoincrement())
  empresa_id Int
  empresa    Empresa @relation(fields: [empresa_id], references: [id])
  tipo       Tipo
  numero     Int // identificador estable dentro de la empresa — nunca reasignado
  nombre     String // editable
  codigo     String // inmutable dentro de la empresa
  orden      Int // posición de visualización dentro del tipo (reordenable)
  activo     Boolean @default(true)
  es_sistema Boolean @default(false) // las 10 tabs originales no se pueden eliminar

  @@unique([tipo, numero, empresa_id])
  @@unique([codigo, empresa_id])
}

// ─── EVENTOS ─────────────────────────────────────────────────────────────────

model Evento {
  id              Int          @id @default(autoincrement())
  empresa_id      Int
  empresa         Empresa      @relation(fields: [empresa_id], references: [id])
  nombre          String
  fecha_inicio    DateTime?
  fecha_fin       DateTime?
  dias_montaje    Int          @default(0) // días de armado previos a fecha_inicio
  dias_desmontaje Int          @default(0) // días de desarmado posteriores a fecha_fin
  estado          EstadoEvento @default(ACTIVO)
  // [{nombre: "Juan", porcentaje: 50}, ...] — N socios, porcentajes suman 100
  socios          Json         @default("[]")
  moneda_base     Moneda       @default(ARS)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  deleted_at      DateTime?
  created_by      Int?
  updated_by      Int?

  movimientos            Movimiento[]
  cuentas                CuentaBancaria[]
  cuentas_vinculadas     EventoCuenta[]
  movimientos_caja       MovimientoCaja[]
  echeqs                 Echeq[]
  accesos                EventoAcceso[]
  asignaciones_stock     AsignacionStock[]
  asignaciones_prestadas AsignacionStock[]  @relation("StockPrestado")
  facturas               Factura[]
  jornadas               Jornada[]
  liquidaciones          Liquidacion[]
  movimientosPanol       MovimientoPanol[]
  rubros_evento          RubroEvento[]
  asignaciones_diarias   AsignacionDiaria[]
  pedidos_comida         PedidoComida[]
  pre_macro              PreMacro?
  movimientosCCC         MovimientoCCC[]
}

// ─── RUBROS (categorías configurables de egresos/ingresos) ───────────────────

model Rubro {
  id            Int           @id @default(autoincrement())
  empresa_id    Int
  empresa       Empresa       @relation(fields: [empresa_id], references: [id])
  tipo          TipoRubro
  nombre        String // "Sonido", "Iluminación", "Tickets", "Sponsors"
  codigo        String? // código interno opcional/estable: "EG-IMP", "EG-EXTRA", "RRHH"
  descripcion   String?
  orden         Int // define el orden de visualización
  activo        Boolean       @default(true)
  es_sistema    Boolean       @default(false) // rubros predefinidos no borrables
  // audit
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  deleted_at    DateTime?
  created_by    Int?
  movimientos   Movimiento[]
  facturas      Factura[]
  rubros_evento RubroEvento[]

  @@unique([empresa_id, tipo, nombre])
}

// ─── FICHA DE EVENTO (Enjoy) ──────────────────────────────────────────────────
// Instancia por evento del catálogo de Rubro: para este evento puntual, qué
// proveedor cubre cada rubro, si está confirmado, quién coordina, y el pedido
// técnico detallado. Reemplaza el armado manual de Festival_KM_-_Pedidos_de_
// material.xlsx / Ficha_de_evento.xlsx / Planilla_Produccion_Expo_Village.xlsx.

enum EstadoRubroEvento {
  PENDIENTE // no asignado todavía
  COTIZANDO // en negociación con proveedor
  CONFIRMADO // proveedor confirmado
  NO_VA // rubro no aplica a este evento
  CANCELADO // se canceló después de confirmado
}

model RubroEvento {
  id                 Int               @id @default(autoincrement())
  evento_id          Int
  evento             Evento            @relation(fields: [evento_id], references: [id])
  rubro_id           Int
  rubro              Rubro             @relation(fields: [rubro_id], references: [id])
  empresa_id         Int
  empresa            Empresa           @relation(fields: [empresa_id], references: [id])
  // Asignación
  proveedor_id       Int?
  proveedor          Proveedor?        @relation(fields: [proveedor_id], references: [id])
  estado             EstadoRubroEvento @default(PENDIENTE)
  // Contacto del proveedor para este evento (puede diferir del proveedor genérico)
  contacto_nombre    String?
  contacto_telefono  String?
  contacto_cargo     String?
  // Coordinación interna
  coordina_nombre    String? // quién de Enjoy coordina este rubro
  // Fechas clave
  fecha_ingreso      DateTime? // cuándo entra el proveedor al evento
  fecha_retiro       DateTime? // cuándo se va
  // Presupuesto
  presupuesto        Decimal?          @db.Decimal(12, 2)
  moneda             Moneda            @default(ARS)
  // Notas generales del rubro en este evento
  notas              String?
  // ── Fuentes mixtas (stock propio + proveedor externo) ────────────────────────
  // Un rubro puede cubrirse con stock propio del depósito, con un proveedor
  // externo, o ambos a la vez (ej: DOS57 con stock insuficiente completa con
  // un proveedor externo). Ver AsignacionStock.rubro_evento_id.
  usa_stock_propio   Boolean           @default(false)
  cantidad_stock     Int? // suma de las AsignacionStock activas vinculadas
  cantidad_proveedor Int? // cantidad cubierta por el proveedor externo
  // audit
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  deleted_at         DateTime?
  created_by         Int?
  updated_by         Int?
  // Pedido técnico detallado (una o más líneas por rubro)
  pedido_items       PedidoItem[]
  asignaciones_stock AsignacionStock[]

  @@unique([evento_id, rubro_id])
}

model PedidoItem {
  id              Int         @id @default(autoincrement())
  rubro_evento_id Int
  rubro_evento    RubroEvento @relation(fields: [rubro_evento_id], references: [id])
  // El pedido técnico: qué se le pide al proveedor
  cantidad        Decimal?    @db.Decimal(10, 2)
  descripcion     String // "Sistema de sonido line array", "Generador 100kva", etc.
  dias_uso        Int?
  horario_llegada String? // texto libre: "08:00", "día anterior al evento"
  horario_retiro  String?
  observaciones   String?
  orden           Int         @default(0)
  // audit
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  deleted_at      DateTime?
}

// ─── MOVIMIENTOS (egresos e ingresos) ────────────────────────────────────────
// Saldo calculado por el backend — el usuario nunca lo escribe directamente.

model Movimiento {
  id                    Int              @id @default(autoincrement())
  evento_id             Int
  evento                Evento           @relation(fields: [evento_id], references: [id])
  tipo                  Tipo
  tab_numero            Int? // legado — 1–5 dentro de su tipo. Nullable: los movimientos
  // nuevos usan rubro_id; se mantiene sólo por compatibilidad
  // con movimientos de RRHH (TabConfig codigo='RRHH').
  rubro_id              Int?
  rubro                 Rubro?           @relation(fields: [rubro_id], references: [id])
  estado_movimiento     EstadoMovimiento @default(PENDIENTE)
  presupuesto           Decimal?         @db.Decimal(15, 2)
  costo_real            Decimal?         @db.Decimal(15, 2)
  responsable_id        Int?
  responsable           Usuario?         @relation(fields: [responsable_id], references: [id])
  fecha_pago            DateTime?
  avisado_proveedor     Boolean          @default(false)
  fecha                 DateTime?
  concepto              String? // opcional en ambos tipos
  descripcion           String?
  debe                  Decimal          @default(0) @db.Decimal(15, 2)
  haber                 Decimal          @default(0) @db.Decimal(15, 2)
  saldo                 Decimal          @default(0) @db.Decimal(15, 2) // CALCULADO — en ARS (ver monto_ars)
  moneda                Moneda           @default(ARS)
  // Cotización a ARS al momento del movimiento — sólo aplica si moneda ≠ ARS.
  tasa_cambio           Decimal?         @db.Decimal(10, 4)
  // Equivalente en ARS de debe/haber (el que esté distinto de cero). Si
  // moneda=ARS, monto_ars = debe o haber sin conversión. Se usa para calcular
  // `saldo` de forma consistente aunque el rubro mezcle movimientos en
  // distinta moneda — ver lib/recalcularSaldos.ts.
  monto_ars             Decimal?         @db.Decimal(15, 2)
  orden                 Int // define la secuencia para recálculo de saldo
  impuesto_subcategoria String? // solo para EG-IMP (rubro.codigo = 'EG-IMP')
  proveedor_id          Int?
  proveedor             Proveedor?       @relation(fields: [proveedor_id], references: [id])
  // Vinculación opcional con un movimiento de caja
  movimiento_caja_id    Int?
  movimiento_caja       MovimientoCaja?  @relation("MovimientoOrigenCaja", fields: [movimiento_caja_id], references: [id])
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
  deleted_at            DateTime?
  created_by            Int?
  updated_by            Int?

  echeq        Echeq?       @relation("EcheqMovimiento")
  pago_factura PagoFactura? @relation("PagoMovimiento")
  liquidacion  Liquidacion?
}

// ─── CAJA ─────────────────────────────────────────────────────────────────────

model CuentaBancaria {
  id            Int        @id @default(autoincrement())
  empresa_id    Int
  empresa       Empresa    @relation(fields: [empresa_id], references: [id])
  // Nullable — una cuenta puede no pertenecer a ningún evento (caja chica por
  // persona, caja de reserva, caja general mensual de empresa: caso DOS57).
  evento_id     Int?
  evento        Evento?    @relation(fields: [evento_id], references: [id])
  nombre        String // "Efectivo", "Banco Galicia", etc.
  tipo          TipoCuenta
  moneda        Moneda     @default(ARS)
  saldo_inicial Decimal    @default(0) @db.Decimal(15, 2)
  // Si el saldo actual cae por debajo de este valor → alerta (ej. Caja Reserva).
  saldo_minimo  Decimal?   @db.Decimal(12, 2)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  deleted_at    DateTime?

  // ── Estado de cuenta / rendición ─────────────────────────────────────────────
  // Ciclo de vida de la caja de un viaje/evento: se abre operativa, al volver
  // el responsable pasa a pendiente de rendición, y el admin cierra al
  // confirmar la rendición. Ver PATCH /api/cuentas/:id/estado.
  estado          EstadoCuenta @default(ABIERTA)
  responsable_id  Int?
  responsable     Usuario?     @relation(fields: [responsable_id], references: [id])
  fecha_apertura  DateTime?
  fecha_cierre    DateTime?
  notas_rendicion String?

  movimientos        MovimientoCaja[]
  eventos_vinculados EventoCuenta[]

  // Permite upsert idempotente por nombre dentro de una empresa (ver seed.ts
  // — cuentas de empresa DOS57 sin evento_id, ej. "Caja Pollo").
  @@unique([nombre, empresa_id])
}

// Vínculo muchos-a-muchos: una cuenta de empresa (evento_id null, ej. "Caja
// Pollo", "Caja Jazmín") puede además operarse desde uno o más eventos sin
// dejar de aparecer en Caja Global — a diferencia de CuentaBancaria.evento_id
// (dueño único, 1 evento). No se usa para cuentas ya propias de un evento.
model EventoCuenta {
  id         Int            @id @default(autoincrement())
  evento_id  Int
  evento     Evento         @relation(fields: [evento_id], references: [id])
  cuenta_id  Int
  cuenta     CuentaBancaria @relation(fields: [cuenta_id], references: [id])
  created_at DateTime       @default(now())
  created_by Int?

  @@unique([evento_id, cuenta_id])
}

// Saldo corriente calculado por el backend — nunca editable directamente.

model MovimientoCaja {
  id                   Int            @id @default(autoincrement())
  cuenta_id            Int
  cuenta               CuentaBancaria @relation(fields: [cuenta_id], references: [id])
  // Evento en cuyo contexto se cargó este movimiento — necesario porque una
  // cuenta puede estar vinculada a varios eventos a la vez (ver EventoCuenta):
  // sin esto, la tab Caja de un evento mostraría movimientos de otros
  // eventos que comparten la misma cuenta. Null = movimiento cargado sin
  // contexto de evento (ej. desde Caja Global, o histórico pre-EventoCuenta
  // en una cuenta que hoy no pertenece a ningún evento).
  evento_id            Int?
  evento               Evento?        @relation(fields: [evento_id], references: [id])
  fecha                DateTime?
  descripcion          String?
  debe                 Decimal        @default(0) @db.Decimal(15, 2)
  haber                Decimal        @default(0) @db.Decimal(15, 2)
  saldo_corriente      Decimal        @default(0) @db.Decimal(15, 2) // CALCULADO
  // Reservado para uso futuro — hoy la moneda de un movimiento de caja es
  // siempre la de su CuentaBancaria (no hace falta convertir para sumar
  // saldo_corriente, que es por-cuenta). Ver lib/convertirARS.ts.
  moneda               Moneda?
  tasa_cambio          Decimal?       @db.Decimal(10, 4)
  monto_ars            Decimal?       @db.Decimal(15, 2)
  orden                Int
  transferencia_par_id Int?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt
  deleted_at           DateTime?
  created_by           Int?
  updated_by           Int?

  // Movimientos de egreso/ingreso que originaron este movimiento de caja
  movimientos_origen Movimiento[] @relation("MovimientoOrigenCaja")
  // Echeqs cobrados que liquidaron en este movimiento bancario
  echeqs_cobrados    Echeq[]      @relation("EcheqCobradoCaja")

  // Sueldo administrativo que generó este egreso — un empleado con split
  // entre empresas genera varios MovimientoCaja (uno por empresa) a partir
  // de una única LiquidacionAdmin. Null en cualquier otro movimiento de caja.
  liquidacion_admin_id Int?
  liquidacion_admin    LiquidacionAdmin? @relation("LiquidacionAdminMovimientos", fields: [liquidacion_admin_id], references: [id])
}

// ─── PROVEEDORES ─────────────────────────────────────────────────────────────

model Proveedor {
  id         Int       @id @default(autoincrement())
  empresa_id Int
  empresa    Empresa   @relation(fields: [empresa_id], references: [id])
  nombre     String
  alias      String?
  cuit       String?   @unique
  categoria  String?
  telefono   String?
  notas      String?
  activo     Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by Int?
  updated_by Int?

  movimientos       Movimiento[]
  echeqs            Echeq[]
  facturas          Factura[]
  rubros_evento     RubroEvento[]
  pedidos_comida    PedidoComida[]
  cuentasCorrientes CuentaCorriente[]
}

// ─── ECHEQS ───────────────────────────────────────────────────────────────────
// Nace desde EG-EXTRA. Al cobrarse, genera un MovimientoCaja automáticamente.

model Echeq {
  id                   Int             @id @default(autoincrement())
  evento_id            Int
  evento               Evento          @relation(fields: [evento_id], references: [id])
  // Movimiento en EG-EXTRA que originó este echeq (uno a uno)
  movimiento_id        Int?            @unique
  movimiento           Movimiento?     @relation("EcheqMovimiento", fields: [movimiento_id], references: [id])
  // MovimientoCaja generado al cobrar este echeq
  movimiento_caja_id   Int?
  movimiento_caja      MovimientoCaja? @relation("EcheqCobradoCaja", fields: [movimiento_caja_id], references: [id])
  proveedor_id         Int?
  proveedor            Proveedor?      @relation(fields: [proveedor_id], references: [id])
  numero               String
  razon_social         String? // auto-filled from proveedor.nombre when proveedor_id is set
  detalle              String?
  importe              Decimal         @db.Decimal(15, 2)
  moneda               Moneda          @default(ARS)
  // Cotización a ARS al momento de cargar el echeq — ver comentario en Movimiento.
  tasa_cambio          Decimal?        @db.Decimal(10, 4)
  monto_ars            Decimal?        @db.Decimal(15, 2)
  estado               EstadoEcheq     @default(PENDIENTE)
  motivo_rechazo       String?
  fecha_emision        DateTime?
  fecha_cobro_estimada DateTime?
  fecha_cobro_real     DateTime?
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt
  deleted_at           DateTime?
  created_by           Int?
  updated_by           Int?

  pago_factura PagoFactura? @relation("PagoEcheq")
}

// ─── ACCESO POR EVENTO ────────────────────────────────────────────────────────

model EventoAcceso {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  usuario    Usuario  @relation(fields: [usuario_id], references: [id])
  evento_id  Int
  evento     Evento   @relation(fields: [evento_id], references: [id])
  rol        Rol
  created_at DateTime @default(now())
  created_by Int?

  @@unique([usuario_id, evento_id])
}

// ─── STOCK ───────────────────────────────────────────────────────────────────

model CategoriaStock {
  id          Int       @id @default(autoincrement())
  empresa_id  Int
  empresa     Empresa   @relation(fields: [empresa_id], references: [id])
  nombre      String
  descripcion String?
  color       String?
  activo      Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  created_by  Int?

  productos Producto[]

  @@unique([nombre, empresa_id])
}

model Producto {
  id           Int             @id @default(autoincrement())
  empresa_id   Int
  empresa      Empresa         @relation(fields: [empresa_id], references: [id])
  nombre       String
  descripcion  String?
  categoria_id Int?
  categoria    CategoriaStock? @relation(fields: [categoria_id], references: [id])
  stock_total  Int
  stock_minimo Int             @default(0)
  unidad       String          @default("unidad")
  notas        String?
  activo       Boolean         @default(true)
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt
  deleted_at   DateTime?
  created_by   Int?
  updated_by   Int?

  // ── Stock madre completo (DOS57 / catálogo Layher) ──────────────────────────
  codigo_interno  String? // código propio de la empresa ("PAR-001")
  codigo_externo  String? // código del fabricante (ej: código Layher oficial)
  nombre_tecnico  String? // nombre técnico formal
  nombre_interno  String? // apodo interno ("torre" en lugar de "vertical")
  foto_data       Bytes? // foto del producto guardada en DB
  foto_nombre     String?
  foto_mime       String?
  valor_unitario  Decimal? @db.Decimal(10, 2) // para cálculo de amortización
  es_critico      Boolean  @default(false) // sin esta pieza no se puede armar
  catalogo_origen String? // "Layher", "Liger", "propio" — solo relevante para DOS57
  peso_unitario   Decimal? @db.Decimal(8, 3) // kg por unidad — catálogo Layher (DOS57)
  espacio         String? // ubicación física en depósito ("DEPO 1", "ALTILLO ENTREPISO") — solo Enjoy

  // ── Stock Enjoy (importador de depósito por espacio) ─────────────────────────
  // [{ periodo: "abr-23", cantidad: 14|null, fecha_aproximada: "2023-04-01" }, ...]
  historial_stock   Json?
  informe_situacion String? // Col H del Excel de Enjoy: "VER FALTANTE", "Reparar", "COMPRAR", etc.

  asignaciones AsignacionStock[]
  movimientos  MovimientoStock[]
  cunas        CunaProducto[]

  @@unique([codigo_interno, empresa_id])
  @@unique([codigo_externo, empresa_id])
  @@unique([empresa_id, nombre, espacio])
}

model AsignacionStock {
  id               Int              @id @default(autoincrement())
  producto_id      Int
  producto         Producto         @relation(fields: [producto_id], references: [id])
  evento_id        Int
  evento           Evento           @relation(fields: [evento_id], references: [id])
  cantidad         Int
  fecha_salida     DateTime
  fecha_retorno    DateTime?
  ubicacion        UbicacionStock   @default(EN_EVENTO)
  estado           EstadoAsignacion @default(ACTIVA)
  origen           OrigenTransfer   @default(DEPOSITO)
  evento_origen_id Int?
  evento_origen    Evento?          @relation("StockPrestado", fields: [evento_origen_id], references: [id])
  notas            String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  deleted_at       DateTime?
  created_by       Int?
  updated_by       Int?

  // ── Vínculo con la Ficha de Evento (fuentes mixtas: stock propio) ────────────
  // Cuando esta asignación cubre (total o parcialmente) un rubro de la ficha,
  // en vez de ser un movimiento de stock genérico del evento.
  rubro_evento_id Int?
  rubro_evento    RubroEvento? @relation(fields: [rubro_evento_id], references: [id])

  // ── Logística DOS57 (camión / cuna) ──────────────────────────────────────────
  camion_id          Int?
  camion             Camion? @relation(fields: [camion_id], references: [id])
  cuna_id            Int?
  cuna               Cuna?   @relation(fields: [cuna_id], references: [id])
  cantidad_excedente Int     @default(0) // material enviado de más

  // ── Firmas digitales (irreversibles — no hay endpoint para "desfirmar") ─────
  firmado_salida      Boolean   @default(false)
  firmado_salida_at   DateTime?
  firmado_salida_por  Int?
  firmado_llegada     Boolean   @default(false)
  firmado_llegada_at  DateTime?
  firmado_llegada_por Int?
  firmado_retorno     Boolean   @default(false)
  firmado_retorno_at  DateTime?
  firmado_retorno_por Int?

  movimientos MovimientoStock[]
}

model MovimientoStock {
  id                Int              @id @default(autoincrement())
  producto_id       Int
  producto          Producto         @relation(fields: [producto_id], references: [id])
  asignacion_id     Int?
  asignacion        AsignacionStock? @relation(fields: [asignacion_id], references: [id])
  tipo              String
  cantidad          Int
  evento_origen_id  Int?
  evento_destino_id Int?
  fecha             DateTime
  descripcion       String?
  created_at        DateTime         @default(now())
  created_by        Int?
}

// ─── CAMIONES / CUNAS (logística DOS57) ──────────────────────────────────────

model Camion {
  id          Int       @id @default(autoincrement())
  empresa_id  Int
  empresa     Empresa   @relation(fields: [empresa_id], references: [id])
  codigo      String // "C1", "C2", "C3", "Van1", etc.
  descripcion String? // "Mercedes Sprinter blanca", "Camión Iveco"
  patente     String?
  tipo        String? // "camion", "camioneta", "van"
  activo      Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  asignaciones         AsignacionStock[]
  jornadas             Jornada[]
  asignaciones_diarias AsignacionDiaria[]

  @@unique([codigo, empresa_id])
}

// Cuna/rack — unidad logística estandarizada de DOS57
model Cuna {
  id          Int       @id @default(autoincrement())
  empresa_id  Int
  empresa     Empresa   @relation(fields: [empresa_id], references: [id])
  codigo      String // "C-001", "R-045", etc.
  descripcion String?
  activo      Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  productos    CunaProducto[]
  asignaciones AsignacionStock[]

  @@unique([codigo, empresa_id])
}

// Contenido estandarizado de una cuna — delete físico (es una relación, no una entidad con historia propia)
model CunaProducto {
  id          Int      @id @default(autoincrement())
  cuna_id     Int
  cuna        Cuna     @relation(fields: [cuna_id], references: [id])
  producto_id Int
  producto    Producto @relation(fields: [producto_id], references: [id])
  cantidad    Int // cantidad de este producto que va en esta cuna

  @@unique([cuna_id, producto_id])
}

// ─── PAÑOL (herramientas y consumibles) ──────────────────────────────────────

model PanolItem {
  id               Int             @id @default(autoincrement())
  empresa_id       Int
  empresa          Empresa         @relation(fields: [empresa_id], references: [id])
  nombre           String
  descripcion      String?
  tipo             TipoPanolItem
  stock_total      Int
  stock_disponible Int // stock_total - en_campo, mantenido transaccionalmente
  valor            Decimal?        @db.Decimal(10, 2)
  estado           EstadoPanolItem @default(DISPONIBLE)
  notas            String?
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  deleted_at       DateTime?
  created_by       Int?

  movimientos MovimientoPanol[]
}

// Movimiento de pañol (salida / devolución / uso interno)
model MovimientoPanol {
  id                 Int          @id @default(autoincrement())
  empresa_id         Int
  empresa            Empresa      @relation(fields: [empresa_id], references: [id])
  panol_item_id      Int
  panol_item         PanolItem    @relation(fields: [panol_item_id], references: [id])
  tipo               TipoMovPanol
  cantidad           Int
  evento_id          Int? // a qué evento va (null si es uso interno)
  evento             Evento?      @relation(fields: [evento_id], references: [id])
  responsable_id     Int? // quién se lo lleva (FK a Usuario o Empleado)
  responsable_nombre String? // nombre libre si no está en el sistema
  fecha              DateTime
  descripcion        String?

  // Para devolución
  cantidad_devuelta Int?
  cantidad_faltante Int?
  motivo_faltante   String?
  devolucion_at     DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by Int?
}

// ─── ACTIVOS (bienes muebles de la empresa) ──────────────────────────────────

model Activo {
  id            Int          @id @default(autoincrement())
  empresa_id    Int
  empresa       Empresa      @relation(fields: [empresa_id], references: [id])
  nombre        String
  descripcion   String?
  categoria     String? // "Vehículo", "Informático", "Mobiliario", "Herramienta"
  numero_serie  String?
  fecha_compra  DateTime?
  valor_compra  Decimal?     @db.Decimal(12, 2)
  estado        EstadoActivo @default(BUENO)
  ubicacion     String? // "Depósito central", "Oficina", "Camión C1"
  observaciones String?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  deleted_at    DateTime?
  created_by    Int?
}

// ─── FACTURAS (cuentas a pagar) ───────────────────────────────────────────────

model Factura {
  id                Int           @id @default(autoincrement())
  empresa_id        Int
  empresa           Empresa       @relation(fields: [empresa_id], references: [id])
  numero_factura    String
  tipo_factura      String // "A", "B", "C", "X"
  fecha_emision     DateTime
  fecha_vencimiento DateTime?
  proveedor_id      Int
  proveedor         Proveedor     @relation(fields: [proveedor_id], references: [id])
  evento_id         Int
  evento            Evento        @relation(fields: [evento_id], references: [id])
  tab_numero        Int?
  tipo_movimiento   Tipo?
  rubro_id          Int?
  rubro             Rubro?        @relation(fields: [rubro_id], references: [id])
  importe_total     Decimal       @db.Decimal(15, 2)
  importe_pagado    Decimal       @default(0) @db.Decimal(15, 2)
  importe_pendiente Decimal       @default(0) @db.Decimal(15, 2)
  moneda            Moneda        @default(ARS)
  // Cotización a ARS al momento de cargar la factura — ver comentario en Movimiento.
  tasa_cambio       Decimal?      @db.Decimal(10, 4)
  monto_ars         Decimal?      @db.Decimal(15, 2)
  condicion_pago    CondicionPago @default(CONTADO)
  estado            EstadoFactura @default(RECIBIDA)
  notas             String?
  pdf_data          Bytes?
  pdf_nombre        String?
  pdf_mime_type     String?
  pdf_tamanio       Int?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  deleted_at        DateTime?
  created_by        Int?
  updated_by        Int?

  pagos          PagoFactura[]
  movimientosCCC MovimientoCCC[]
}

model PagoFactura {
  id            Int         @id @default(autoincrement())
  factura_id    Int
  factura       Factura     @relation(fields: [factura_id], references: [id])
  fecha_pago    DateTime
  importe       Decimal     @db.Decimal(15, 2)
  moneda        Moneda      @default(ARS)
  medio_pago    MedioPago
  referencia    String?
  notas         String?
  movimiento_id Int?        @unique
  movimiento    Movimiento? @relation("PagoMovimiento", fields: [movimiento_id], references: [id])
  echeq_id      Int?        @unique
  echeq         Echeq?      @relation("PagoEcheq", fields: [echeq_id], references: [id])
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  deleted_at    DateTime?
  created_by    Int?
}

// ─── PARTE DIARIO DE PERSONAL (DOS57) ────────────────────────────────────────
// Reemplaza la planilla "TAREAS PERSONAL DIARIO" que se arma a mano cada día.
// Al cerrar el parte, genera las Jornada correspondientes (para su posterior
// aprobación) — es la fuente de horas trabajadas y de despacho diario.

enum EstadoAsignacionDiaria {
  ASIGNADO
  LIBRE // sin tarea ese día
  VACACIONES
  AUSENTE
  NO_CITADO
}

model ParteDiario {
  id         Int       @id @default(autoincrement())
  empresa_id Int
  empresa    Empresa   @relation(fields: [empresa_id], references: [id])
  fecha      DateTime // la fecha del parte (sin hora)
  titulo     String? // ej: "Viernes 24/07/2026"
  notas      String? // nota al pie (ej: "Modificaciones validar en grupo TODOS")
  cerrado    Boolean   @default(false) // cuando está cerrado no se edita
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by Int?

  asignaciones AsignacionDiaria[]

  @@unique([empresa_id, fecha])
}

model AsignacionDiaria {
  id               Int                    @id @default(autoincrement())
  parte_diario_id  Int
  parte_diario     ParteDiario            @relation(fields: [parte_diario_id], references: [id])
  empleado_id      Int
  empleado         Empleado               @relation(fields: [empleado_id], references: [id])
  empresa_id       Int
  empresa          Empresa                @relation(fields: [empresa_id], references: [id])
  // Asignación del día
  estado           EstadoAsignacionDiaria @default(ASIGNADO)
  hora_ingreso     String? // "08:00", "09:00" — texto para flexibilidad
  lugar            String? // "Polo", "Santiago del Estero", "Depósito"
  tarea            String? // descripción libre de la tarea
  seccion          String? // "Administración", "Depósito", "Eventos"
  // Orden de despliegue dentro de la sección (drag & drop en el frontend) —
  // no estaba en el pedido original pero es imprescindible para persistir el
  // reordenamiento, igual que Movimiento.orden / PedidoItem.orden.
  orden            Int                    @default(0)
  // Vehículo asignado al grupo (puede ser el mismo para varios)
  camion_id        Int?
  camion           Camion?                @relation(fields: [camion_id], references: [id])
  vehiculo_texto   String? // texto libre si no está en Camiones — ej: "Camioneta HLW 156", "Sprinter"
  // Vínculo con evento formal (opcional)
  evento_id        Int?
  evento           Evento?                @relation(fields: [evento_id], references: [id])
  // Hora de salida (se completa al final del día o la siguen)
  hora_salida      String? // "***" en el Excel original significa voluntaria
  hora_salida_fija Boolean                @default(false) // true = hora computada, false = voluntaria
  // Al cerrar el parte → crear Jornada automáticamente
  jornada_id       Int?                   @unique
  jornada          Jornada?               @relation(fields: [jornada_id], references: [id])
  // audit
  created_at       DateTime               @default(now())
  updated_at       DateTime               @updatedAt
  deleted_at       DateTime?

  @@unique([parte_diario_id, empleado_id])
}

// ─── COMIDAS (Enjoy y DOS57) ──────────────────────────────────────────────────
// Registro operativo de viandas/comidas por día de evento: cuántos almuerzos y
// cenas por área, con qué proveedor. Reemplaza las planillas manuales
// (Planilla_Control_de_Viandas.xlsx, DOS57_RESUMEN_COMIDAS_2026.xlsx). Vive
// dentro del evento — no crea movimientos automáticamente, es solo registro.

enum TipoComida {
  ALMUERZO
  CENA
  DESAYUNO
  MERIENDA
}

model PedidoComida {
  id              Int        @id @default(autoincrement())
  evento_id       Int
  evento          Evento     @relation(fields: [evento_id], references: [id])
  empresa_id      Int
  empresa         Empresa    @relation(fields: [empresa_id], references: [id])
  fecha           DateTime // fecha del día de comida
  proveedor_id    Int?
  proveedor       Proveedor? @relation(fields: [proveedor_id], references: [id])
  proveedor_texto String? // nombre libre si no está en sistema
  forma_pago      String? // "Cuenta corriente", "Efectivo", "Transferencia"
  notas           String?
  // audit
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  deleted_at      DateTime?
  created_by      Int?
  updated_by      Int?

  lineas LineaComida[]

  @@unique([evento_id, fecha])
}

model LineaComida {
  id               Int          @id @default(autoincrement())
  pedido_comida_id Int
  pedido_comida    PedidoComida @relation(fields: [pedido_comida_id], references: [id])
  tipo             TipoComida
  area             String // "Administración", "Depósito", "Eventos", "Staff"
  cantidad         Int
  valor_unitario   Decimal?     @db.Decimal(10, 2)
  detalle          String? // descripción del menú o nombres de personas
  // audit
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  deleted_at       DateTime?

  @@unique([pedido_comida_id, tipo, area])
}

// ─── RRHH ─────────────────────────────────────────────────────────────────────

model Empleado {
  id               Int               @id @default(autoincrement())
  empresa_id       Int
  empresa          Empresa           @relation(fields: [empresa_id], references: [id])
  // Datos personales
  nombre           String
  apellido         String
  // Nullable — el personal fijo de DOS57 se identifica por CUIL, no siempre
  // tiene DNI cargado en el legajo. Sigue siendo obligatorio en el alta manual
  // desde la UI (validación a nivel de Zod, no de schema).
  dni              String?
  cuit             String?
  email            String?
  telefono         String?
  domicilio        String?
  // Datos bancarios
  cbu              String?
  alias            String?
  banco            String?
  // Datos laborales
  categoria        CategoriaEmpleado @default(OTRO)
  valor_hora       Decimal           @default(0) @db.Decimal(10, 2)
  valor_hora_extra Decimal           @default(0) @db.Decimal(10, 2)
  estado           EstadoEmpleado    @default(ACTIVO)
  notas            String?

  // ── Modelo de liquidación ────────────────────────────────────────────────────
  // LINEAL (Enjoy): horas_normales × valor_hora + horas_extras × valor_hora_extra.
  // JORNADA (DOS57): tarifa por día con umbral de horas — ver calcularLiquidacion.ts.
  tipo_liquidacion         TipoLiquidacion @default(LINEAL)
  valor_jornada_completa   Decimal?        @db.Decimal(10, 2)
  valor_media_jornada      Decimal?        @db.Decimal(10, 2)
  umbral_horas_jornada     Decimal?        @db.Decimal(5, 2) // horas a partir de las cuales se cobra jornada completa
  umbral_horas_media       Decimal?        @db.Decimal(5, 2) // horas mínimas para cobrar media jornada
  valor_hora_extra_jornada Decimal?        @db.Decimal(10, 2) // valor de cada hora extra sobre umbral_horas_jornada
  valor_viaje              Decimal?        @db.Decimal(10, 2) // adicional fijo por viaje (choferes)

  // ── Legajo ────────────────────────────────────────────────────────────────────
  apodo                      String? // distinto de `alias`, que es el alias bancario/CBU
  fecha_nacimiento           DateTime?
  grupo_sanguineo            String?
  contacto_emergencia_nombre String?
  contacto_emergencia_tel    String?
  contacto_emergencia_tel2   String? // segundo teléfono de emergencia
  escalafon                  Int? // nivel numérico — significado a confirmar con el cliente
  art                        String? // aseguradora ART
  tipo_contratacion          String? // "SANCOR", "ART", "FEDERAL PATRONAL (AP)", etc. — texto libre
  licencia_conducir          Boolean   @default(false)
  equipamiento_asignado      String? // celular/notebook/etc.
  talle_pantalon             String?
  talle_remera               String?
  talle_buzo                 String?
  talle_calzado              String?

  // Usuario del sistema (opcional — si el empleado carga sus propias jornadas)
  usuario_id           Int?                   @unique
  usuario              Usuario?               @relation(fields: [usuario_id], references: [id])
  // audit
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  deleted_at           DateTime?
  created_by           Int?
  // relations
  jornadas             Jornada[]
  anticipos            Anticipo[]
  liquidaciones        Liquidacion[]
  asignaciones_diarias AsignacionDiaria[]
  // Sueldos administrativos (régimen mensual fijo, distinto de Jornada/Liquidacion)
  acuerdo_sueldo       AcuerdoSueldo?
  splits_empresa       EmpleadoEmpresaSplit[]
  liquidaciones_admin  LiquidacionAdmin[]
}

model Jornada {
  id                Int           @id @default(autoincrement())
  empleado_id       Int
  empleado          Empleado      @relation(fields: [empleado_id], references: [id])
  evento_id         Int? // opcional — puede ser trabajo en depósito
  evento            Evento?       @relation(fields: [evento_id], references: [id])
  empresa_id        Int // desnormalizado para filtrar por tenant fácilmente
  empresa           Empresa       @relation(fields: [empresa_id], references: [id])
  fecha             DateTime
  hora_convocatoria DateTime? // hora a la que se pidió que llegue
  hora_ingreso      DateTime? // hora real de ingreso
  hora_egreso       DateTime? // hora real de salida
  horas_normales    Decimal       @default(0) @db.Decimal(5, 2) // calculado
  horas_extras      Decimal       @default(0) @db.Decimal(5, 2) // calculado
  descripcion       String?
  estado            EstadoJornada @default(PENDIENTE)
  motivo_rechazo    String?

  // ── Despacho diario (relevamiento DOS57) ──────────────────────────────────────
  cantidad_viajes Int? // para choferes: viajes realizados ese día
  convocatoria    String? // nombre del evento/cliente ("SANTIAGO.E", "POLO", etc.) —
  // puede no coincidir con un Evento formal del sistema
  lugar_trabajo   String? // "Polo", "Santiago del Estero", "Depósito", etc.
  camion_id       Int?
  camion          Camion? @relation(fields: [camion_id], references: [id])

  // audit
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?
  created_by   Int?
  aprobado_por Int?
  aprobado_at  DateTime?

  asignacion_diaria AsignacionDiaria?

  @@unique([empleado_id, fecha])
}

model Anticipo {
  id             Int          @id @default(autoincrement())
  empleado_id    Int
  empleado       Empleado     @relation(fields: [empleado_id], references: [id])
  empresa_id     Int
  empresa        Empresa      @relation(fields: [empresa_id], references: [id])
  tipo           TipoAnticipo @default(ADELANTO)
  monto          Decimal      @db.Decimal(10, 2)
  fecha          DateTime
  motivo         String?
  descontado     Boolean      @default(false) // true cuando se aplicó en una liquidación
  liquidacion_id Int?
  liquidacion    Liquidacion? @relation(fields: [liquidacion_id], references: [id])
  // audit
  created_at     DateTime     @default(now())
  created_by     Int?
}

model Liquidacion {
  id               Int               @id @default(autoincrement())
  empleado_id      Int
  empleado         Empleado          @relation(fields: [empleado_id], references: [id])
  empresa_id       Int
  empresa          Empresa           @relation(fields: [empresa_id], references: [id])
  evento_id        Int? // si la liquidación es por evento específico
  evento           Evento?           @relation(fields: [evento_id], references: [id])
  // Período
  fecha_desde      DateTime
  fecha_hasta      DateTime
  // Cálculo
  // Snapshot del tipo de cálculo usado — no cambia si luego se edita el
  // empleado, para que el historial de liquidaciones ya aprobadas sea estable.
  tipo_liquidacion TipoLiquidacion   @default(LINEAL)
  horas_normales   Decimal           @db.Decimal(8, 2)
  horas_extras     Decimal           @db.Decimal(8, 2)
  valor_hora       Decimal           @db.Decimal(10, 2) // snapshot al momento de liquidar
  valor_hora_extra Decimal           @db.Decimal(10, 2) // snapshot
  subtotal_horas   Decimal           @db.Decimal(10, 2) // normales × valor + extras × valor_extra
  total_anticipos  Decimal           @db.Decimal(10, 2) // suma de anticipos descontados
  total_descuentos Decimal           @db.Decimal(10, 2) // otros descuentos
  total_a_cobrar   Decimal           @db.Decimal(10, 2) // subtotal - anticipos - descuentos
  estado           EstadoLiquidacion @default(BORRADOR)
  observaciones    String?
  // Al aprobar → genera Egreso automático
  movimiento_id    Int?              @unique
  movimiento       Movimiento?       @relation(fields: [movimiento_id], references: [id])
  // audit
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  aprobado_por     Int?
  aprobado_at      DateTime?
  anticipos        Anticipo[]
}

// ─── SUELDOS ADMINISTRATIVOS (DOS57) ─────────────────────────────────────────
// Régimen distinto al de Jornada/Liquidacion (jornaleros por hora/día): sueldo
// mensual fijo con conceptos variables, acordado individualmente con Matías, y
// posible reparto de costo entre empresas cuando el empleado trabaja para más
// de una (ej. Mayra: 32% Enjoy / 68% DOS57).

// Split de costo entre empresas — configurable por empleado. La suma de
// porcentajes de todos los splits de un empleado debe dar 100 (se valida en
// el controller, mismo criterio que ParteCCC/Evento.socios).
model EmpleadoEmpresaSplit {
  id          Int      @id @default(autoincrement())
  empleado_id Int
  empleado    Empleado @relation(fields: [empleado_id], references: [id])
  empresa_id  Int
  empresa     Empresa  @relation(fields: [empresa_id], references: [id])
  porcentaje  Decimal  @db.Decimal(5, 2)

  @@unique([empleado_id, empresa_id])
}

// Acuerdo individual de sueldo — se fija al contratar/renegociar. Un empleado
// tiene a lo sumo un acuerdo (1:1); renegociar implica editar este registro
// (ver validación en updateAcuerdo: no se puede tocar si ya hay liquidaciones
// APROBADAS, para no invalidar snapshots históricos).
model AcuerdoSueldo {
  id                  Int      @id @default(autoincrement())
  empleado_id         Int      @unique
  empleado            Empleado @relation(fields: [empleado_id], references: [id])
  empresa_id          Int // empresa principal del acuerdo
  empresa             Empresa  @relation(fields: [empresa_id], references: [id])
  // Acuerdo
  fecha_inicio        DateTime
  vigencia_meses      Int? // null = indefinido
  escalafon           String? // "ADM 1", "ADM 2", "ADM 3"
  tipo_seguro         String? // "ART", "SANCOR", "FEDERAL PATRONAL"
  // Sueldo base
  sueldo_basico       Decimal  @db.Decimal(12, 2)
  horas_acordadas_mes Int      @default(200)
  // Conceptos fijos (configurables por acuerdo)
  premio_incentivo    Decimal? @db.Decimal(12, 2)
  viatico             Decimal? @db.Decimal(12, 2)
  premio_presentismo  Decimal? @db.Decimal(12, 2)
  // Horas extras
  valor_hora_extra    Decimal? @db.Decimal(10, 2)
  // Teléfono (algunos empleados lo tienen) — antigüedad NO vive acá: se
  // recalcula siempre desde fecha_inicio con la tabla fija de
  // calcularSueldoAdmin.ts, nunca se persiste en el acuerdo.
  telefono            Decimal? @db.Decimal(10, 2)
  // Estado del acuerdo
  activo              Boolean  @default(true)
  notas               String?
  // audit
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  created_by          Int?

  liquidaciones LiquidacionAdmin[]
}

enum EstadoLiquidacionAdmin {
  BORRADOR
  APROBADA
  PAGADA
  CANCELADA
}

// Liquidación mensual administrativa — un registro por empleado/mes/año.
model LiquidacionAdmin {
  id                   Int                    @id @default(autoincrement())
  empleado_id          Int
  empleado             Empleado               @relation(fields: [empleado_id], references: [id])
  empresa_id           Int // empresa principal (snapshot del acuerdo)
  empresa              Empresa                @relation(fields: [empresa_id], references: [id])
  acuerdo_id           Int
  acuerdo              AcuerdoSueldo          @relation(fields: [acuerdo_id], references: [id])
  // Período
  periodo_mes          Int // 1-12
  periodo_anio         Int
  // Snapshots del acuerdo al momento de liquidar — estables aunque después se
  // edite/renegocie el acuerdo (mismo criterio que Liquidacion.tipo_liquidacion).
  sueldo_basico        Decimal                @db.Decimal(12, 2)
  horas_acordadas      Int
  escalafon            String?
  // Conceptos calculados
  horas_trabajadas     Decimal                @db.Decimal(8, 2)
  horas_extras         Decimal                @db.Decimal(8, 2)
  valor_hora_extra     Decimal?               @db.Decimal(10, 2)
  importe_horas_extras Decimal                @default(0) @db.Decimal(12, 2)
  premio_incentivo     Decimal                @default(0) @db.Decimal(12, 2)
  viatico              Decimal                @default(0) @db.Decimal(12, 2)
  premio_presentismo   Decimal                @default(0) @db.Decimal(12, 2)
  antiguedad_anios     Int                    @default(0)
  importe_antiguedad   Decimal                @default(0) @db.Decimal(12, 2)
  telefono             Decimal                @default(0) @db.Decimal(12, 2)
  vacaciones_aguinaldo Decimal                @default(0) @db.Decimal(12, 2)
  vales_descuentos     Decimal                @default(0) @db.Decimal(12, 2)
  // Totales
  subtotal_bruto       Decimal                @db.Decimal(12, 2)
  total_a_cobrar       Decimal                @db.Decimal(12, 2)
  // Split entre empresas (snapshot al momento de liquidar) —
  // [{ empresa_id, empresa_nombre, porcentaje, monto }]
  splits               Json?
  // Estado
  estado               EstadoLiquidacionAdmin @default(BORRADOR)
  observaciones        String?
  // Al aprobar → uno o más MovimientoCaja de egreso (uno por empresa del
  // split, o uno solo si no hay split) — ver aprobarLiquidacionAdmin.
  movimientos_caja     MovimientoCaja[]       @relation("LiquidacionAdminMovimientos")
  // audit
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  aprobado_por         Int?
  aprobado_at          DateTime?

  @@unique([empleado_id, periodo_mes, periodo_anio])
}

// ─── AUDITORÍA ────────────────────────────────────────────────────────────────

model AuditoriaLog {
  id            Int      @id @default(autoincrement())
  usuario_id    Int?
  usuario       Usuario? @relation(fields: [usuario_id], references: [id])
  empresa_id    Int?
  empresa       Empresa? @relation(fields: [empresa_id], references: [id])
  accion        String
  entidad       String
  entidad_id    Int?
  evento_id     Int?
  descripcion   String
  datos_antes   Json?
  datos_despues Json?
  ip            String?
  created_at    DateTime @default(now())
}

// ─── PRE-MACRO (wizard de creación de evento) ────────────────────────────────
// Punto de entrada para crear un evento nuevo: ayuda-memoria de 4 pasos que
// termina en un resumen + selección de rubros preseleccionados. Aplica a
// Enjoy y DOS57 por igual — la lógica de sugerencia de rubros difiere por
// empresa (ver src/lib/sugerirRubros.ts).

model PreMacro {
  id          Int     @id @default(autoincrement())
  empresa_id  Int
  empresa     Empresa @relation(fields: [empresa_id], references: [id])
  // Estado del wizard
  paso_actual Int     @default(1)
  completada  Boolean @default(false)
  // Evento resultante (null hasta que se confirma)
  evento_id   Int?    @unique
  evento      Evento? @relation(fields: [evento_id], references: [id])

  // PASO 1 — El evento
  nombre_evento String?
  tipo_evento   String? // "Festival", "Corporativo", "Privado", "Deportivo", otro
  descripcion   String?
  para_que_es   String? // texto libre: para qué es el evento
  es_privado    Boolean @default(false)

  // PASO 2 — Dónde y cuándo
  fecha_inicio    DateTime?
  fecha_fin       DateTime?
  hora_inicio     String? // "20:00"
  hora_fin        String?
  lugar_nombre    String? // "Estadio Mario Kempes"
  lugar_ciudad    String?
  lugar_provincia String?
  lugar_direccion String?
  dias_montaje    Int? // días de armado previos al evento
  dias_desmontaje Int? // días de desarmado posteriores

  // PASO 3 — Quién y cómo
  cliente_nombre    String? // quién lo encarga
  razon_social      String? // razón social que paga
  cuit_pagador      String?
  quien_lo_hace     String? // responsable interno de Enjoy/DOS57
  contacto_cliente  String?
  telefono_cliente  String?
  presupuesto_total Decimal? @db.Decimal(12, 2)
  moneda            Moneda   @default(ARS)

  // PASO 4 — Personal y logística
  lleva_empleados         Boolean @default(true)
  cantidad_estimada_staff Int?
  requiere_hospedaje      Boolean @default(false)
  ciudad_hospedaje        String?
  requiere_traslado       Boolean @default(false)
  notas_traslado          String? // "2 camiones + 1 van"
  requiere_comidas        Boolean @default(false)
  cantidad_dias_comida    Int?
  observaciones_generales String?

  // Rubros sugeridos (JSON array de { rubro_id, rubro_nombre, razon, seleccionado })
  rubros_sugeridos   Json?
  rubros_confirmados Json?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by Int?

  // Socios del evento (mismo modelo conceptual que Evento.socios)
  socios SocioPreMacro[]
}

model SocioPreMacro {
  id           Int      @id @default(autoincrement())
  pre_macro_id Int
  pre_macro    PreMacro @relation(fields: [pre_macro_id], references: [id])
  nombre       String
  porcentaje   Decimal  @db.Decimal(5, 2)
}

// ─── CUENTA CORRIENTE GENÉRICA ────────────────────────────────────────────────
// Patrón recurrente detectado en las planillas de Mayra: tercero → movimientos
// Debe/Haber → saldo acumulado, con soporte de moneda extranjera y reparto
// porcentual entre partes (ej. clubes deportivos, proveedores especiales tipo
// Airasca/Layher BB, socios de negocios compartidos tipo Nave 15).

enum TipoTercero {
  PROVEEDOR // proveedor ya registrado en el sistema (usa proveedor_id)
  CLIENTE // cliente externo, sin ficha propia
  SOCIO // socio de negocio compartido (ej. Nave 15, Coworking)
  CLUB // club deportivo u organización
  OTRO // cualquier otro tercero, texto libre
}

// Moneda propia del módulo — históricamente separada de Moneda porque ese
// enum sólo tenía ARS/USD. Moneda ganó EUR con el soporte multi-moneda de
// Movimiento/Factura/Echeq, así que hoy son equivalentes; se mantiene como
// tipo aparte por prolijidad de dominio (este módulo es cuenta corriente,
// no caja de eventos) y para no acoplar CCC a cambios futuros de Moneda.
enum MonedaCCC {
  ARS
  USD
  EUR
}

model CuentaCorriente {
  id         Int     @id @default(autoincrement())
  empresa_id Int
  empresa    Empresa @relation(fields: [empresa_id], references: [id])

  // Tercero — o bien un Proveedor ya cargado, o bien datos libres
  tipo_tercero   TipoTercero
  proveedor_id   Int?
  proveedor      Proveedor?  @relation(fields: [proveedor_id], references: [id])
  tercero_nombre String?
  tercero_cuit   String?

  // Configuración
  nombre      String // "Cta Cte Airasca", "Cta Cte Talleres"
  moneda      MonedaCCC @default(ARS)
  descripcion String?
  activa      Boolean   @default(true)

  // Saldo desnormalizado — se recalcula sumando los movimientos activos cada
  // vez que uno se crea/edita/elimina (mismo criterio que Factura.importe_pagado
  // vía recalcularFactura, en vez de acumular con +=, para no arrastrar drift).
  // Positivo = a favor nuestro (nos deben) · Negativo = a favor del tercero
  // (les debemos). Ver TipoMovCCC para la convención de signo por movimiento.
  saldo_actual Decimal @default(0) @db.Decimal(15, 2)

  // Reparto porcentual entre partes (ej. Nave 15 — DOS57/Jiménez 50/50)
  tiene_reparto Boolean @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by Int?
  updated_by Int?

  partes      ParteCCC[]
  movimientos MovimientoCCC[]
}

// Reparto porcentual entre partes de una cuenta corriente (ej: Nave 15 — 50/50).
// La suma de porcentajes = 100 se valida en el controller, no en el schema.
model ParteCCC {
  id            Int             @id @default(autoincrement())
  cuenta_ccc_id Int
  cuenta_ccc    CuentaCorriente @relation(fields: [cuenta_ccc_id], references: [id])
  nombre        String // "DOS57", "Jiménez", "Galera"
  porcentaje    Decimal         @db.Decimal(5, 2)
}

// DEBE suma al saldo, HABER resta — saldo = Σ DEBE − Σ HABER (+ AJUSTE con su
// propio signo). Positivo = el tercero nos debe, negativo = nosotros les debemos.
enum TipoMovCCC {
  DEBE // cargo al tercero — lo que nos debe, aumenta el saldo a favor nuestro
  HABER // pago o abono al tercero — reduce el saldo a favor nuestro
  AJUSTE // corrección manual; el monto lleva signo propio (+/-)
}

model MovimientoCCC {
  id            Int             @id @default(autoincrement())
  cuenta_ccc_id Int
  cuenta_ccc    CuentaCorriente @relation(fields: [cuenta_ccc_id], references: [id])
  empresa_id    Int
  empresa       Empresa         @relation(fields: [empresa_id], references: [id])

  tipo        TipoMovCCC
  fecha       DateTime
  concepto    String
  descripcion String?
  monto       Decimal    @db.Decimal(15, 2) // DEBE/HABER siempre positivo; AJUSTE lleva signo
  moneda      MonedaCCC
  tasa_cambio Decimal?   @db.Decimal(10, 4) // cotización a ARS al momento del movimiento
  monto_ars   Decimal?   @db.Decimal(15, 2) // monto convertido a ARS con tasa_cambio
  // Saldo acumulado de la cuenta después de este movimiento — persistido y
  // recalculado en cada alta/baja (ver lib/recalcularSaldoCCC.ts), mismo
  // criterio que Movimiento.saldo.
  saldo       Decimal    @default(0) @db.Decimal(15, 2)

  // Vínculo opcional con otros módulos
  factura_id Int?
  factura    Factura? @relation(fields: [factura_id], references: [id])
  evento_id  Int?
  evento     Evento?  @relation(fields: [evento_id], references: [id])

  // Documento adjunto — mismo patrón que Factura.pdf_data (bytes en DB +
  // endpoint de descarga dedicado, no hay storage externo en este proyecto)
  documento_data    Bytes?
  documento_nombre  String?
  documento_mime    String?
  documento_tamanio Int?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by Int?
  updated_by Int?
}
